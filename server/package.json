{
    "name": "@weragen/server",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsc-watch -p tsconfig.json --noClear --onSuccess \"node --enable-source-maps dist/main.js\"",
        "build": "prisma generate && tsc -p tsconfig.json",
        "start": "node dist/main.js",
        "typecheck": "tsc --noEmit",
        "db:push": "dotenv -e ../.env -- prisma db push && dotenv -e ../.env -- prisma generate",
        "diagnostics": "effect-tsgo diagnostics --project tsconfig.json"
    },
    "prisma": {
        "schema": "prisma/schema.prisma"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.30.0",
        "@nestjs/common": "^12.0.1",
        "@nestjs/core": "^12.0.1",
        "@nestjs/platform-fastify": "^12.0.1",
        "@opentelemetry/api": "^1.9.1",
        "@opentelemetry/exporter-trace-otlp-proto": "^0.222.0",
        "@opentelemetry/resources": "^2.11.0",
        "@opentelemetry/sdk-trace-node": "^2.11.0",
        "@opentelemetry/semantic-conventions": "^1.43.0",
        "@prisma/adapter-pg": "^7.8.0",
        "@prisma/client": "^7.8.0",
        "@weragen/ai": "^0.1.0",
        "@weragen/types": "^0.1.0",
        "dotenv": "^17.4.2",
        "effect": "4.0.0-rc.118",
        "jose": "^6.2.11",
        "openai": "^7.10.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/node": "^25.9.1",
        "dotenv-cli": "^11.0.0",
        "prisma": "^7.8.0",
        "typescript": "^7.0.2"
    }
}
