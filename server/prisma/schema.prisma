generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
  runtime                = "nodejs"
}

datasource db {
  provider = "postgresql"
}

/// Владелец сессий. Аутентификации в версии 0.1.0 нет — работает единственная локальная
/// учётная запись, создаваемая при первом запуске. Колонка владельца присутствует с самого
/// начала намеренно: добавление её задним числом затрагивает каждый запрос и каждую проверку.
model User {
  id        String    @id @default(uuid())
  login     String    @unique
  createdAt DateTime  @default(now())
  sessions  Session[]

  @@map("users")
}

/// Вид сессии. Виды различаются тем, кто подаёт вход и что считается завершением; журнал,
/// поток событий, прерывание и владелец у них общие, поэтому запись одна на все три.
enum SessionKind {
  chat
  workflow
  agent
}

/// Состояние сессии. Терминальные состояния достижимы только для видов `workflow` и
/// `agent`: чат-сессия завершения не имеет и остаётся в `idle` между ходами.
enum SessionStatus {
  idle
  running
  completed
  failed
}

/// Карточка воркфлоу в реестре платформы.
///
/// Платформа не содержит перечня реализаций: карточку заводит администратор, а состав
/// воркфлоу — версию, описание, схему входа и требования — платформа узнаёт у самого
/// процесса. Поэтому добавление воркфлоу не требует правок в её коде.
model Workflow {
  id   String @id @default(uuid())
  /// Имя, по которому воркфлоу запускается. Совпадает с именем в спецификации процесса.
  name String @unique

  /// Рабочий каталог процесса и команда запуска. Платформа порождает процесс на каждое
  /// исполнение: постоянно работающих процессов воркфлоу нет.
  packagePath String
  command     String @default("node")
  args        Json   @default("[\"dist/main.js\"]")
  env         Json   @default("{}")

  /// Спецификация, полученная от процесса при последней проверке. Хранится целиком:
  /// схема входа нужна для формы запуска и для описания инструмента агента, а требования —
  /// для повторной сверки без запуска процесса.
  spec Json?

  checkStatus      String    @default("unknown")
  /// Чего именно недостаёт при состоянии `unsatisfied`.
  missing          Json      @default("[]")
  lastCheckAt      DateTime?
  lastCheckMessage String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  sessions  Session[]

  @@map("workflows")
}

/// Подключение MCP: внешний сервер, поставляющий платформе инструменты.
///
/// Как и у воркфлоу, платформа хранит карточку — где сервер находится и чем запускается, —
/// а состав инструментов узнаёт у самого сервера. В отличие от воркфлоу, полученный состав
/// хранится и служит источником истины: набор инструментов хода собирается из снимка, без
/// обращения к серверу, поэтому задержка начала хода не зависит от числа подключений.
model McpConnection {
  id String @id @default(uuid())
  /// Слаг подключения. Он же префикс имён инструментов, поэтому уникален по справочнику:
  /// совпадение имён между подключениями исключается по построению.
  name    String  @unique
  title   String?
  enabled Boolean @default(true)

  /// Транспорт и его настройки: stdio (дочерний процесс) либо http (сессия Streamable HTTP).
  /// Секреты — заголовки и переменные окружения — находятся здесь и только здесь, поэтому
  /// шифрование, когда оно понадобится, затронет одно место, а не каждый запрос.
  transport String
  config    Json

  /// Снимок состава, полученный при последнем обнаружении.
  snapshot     Json?
  /// Режим отбора инструментов: all, except либо selected. Пусто у карточек, созданных до
  /// появления режима; для них режим выводится из перечня: пустой означает all, непустой —
  /// selected. Первая же правка карточки записывает режим явно.
  toolMode      String?
  /// Отобранные инструменты для режима selected. Имена исчезнувших с сервера инструментов
  /// из перечня не удаляются.
  enabledTools  Json    @default("[]")
  /// Исключённые инструменты для режима except. Хранятся так же, как отобранные.
  excludedTools Json    @default("[]")

  checkStatus String @default("unknown")
  /// Что именно непригодно при состоянии `unsatisfied`.
  problems    Json   @default("[]")
  /// Снимок разошёлся с сервером: вызов отклонён как неизвестный либо не соответствующий
  /// схеме. Снимается успешной проверкой.
  stale       Boolean @default(false)

  lastCheckAt      DateTime?
  lastCheckMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("mcp_connections")
}

/// Справочник моделей платформы. Один на всю установку, как и пометка модели по умолчанию.
/// Единственный источник модели: в конфигурации её нет, и пока справочник пуст, ход агента
/// не запускается.
model LlmModel {
  id String @id @default(uuid())
  /// Короткое имя модели либо полный URI. Короткое дополняется каталогом из конфигурации.
  /// Задаётся при создании и не меняется: запись и модель соответствуют друг другу
  /// однозначно, и сессия, закреплённая за записью, не может перейти на другую модель без
  /// явного выбора.
  identifier String  @unique
  isDefault  Boolean @default(false)

  /// Признаки, проставляемые вручную: перечень моделей провайдера сведений о возможностях
  /// не содержит. Ни на что пока не влияют, но фиксируются в карточке.
  supportsTools     Boolean @default(false)
  supportsReasoning Boolean @default(false)

  /// Доступность: есть ли модель в перечне провайдера. Обновляется по таймеру, поэтому
  /// хранится, а не вычисляется при каждом обращении к справочнику.
  availability     String    @default("unknown")
  lastCheckAt      DateTime?
  lastCheckMessage String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  sessions  Session[]

  @@map("llm_models")
}

model Session {
  id      String        @id @default(uuid())
  ownerId String
  owner   User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title   String
  kind    SessionKind   @default(chat)
  status  SessionStatus @default(idle)

  /// Порождающая сессия. Дерево хранится одной самосвязью: вложенность существует в
  /// отрисовке, а читается дочерняя сессия теми же запросами, что и любая другая.
  /// Удаление родителя уносит потомков — по отдельности они лишены смысла.
  parentId String?
  parent   Session?  @relation("SessionTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Session[] @relation("SessionTree")

  /// Карточка реестра — только для сессий вида `workflow`.
  workflowId String?
  workflow   Workflow? @relation(fields: [workflowId], references: [id], onDelete: SetNull)

  /// Итог завершённой сессии и причина отказа. У чат-сессии остаются пустыми.
  result         Json?
  failureMessage String?

  /// Число событий в журнале. Служит источником порядкового номера: запись события и
  /// увеличение счётчика идут одной транзакцией, что даёт монотонную нумерацию без
  /// отдельной последовательности.
  eventCount Int @default(0)

  /// Время последнего события журнала. Хранится отдельно от `updatedAt`, потому что порядок
  /// в списке должен отражать работу в сессии, а не любое изменение её записи:
  /// переименование, смена модели и запись заметки меняют `updatedAt`, не будучи событием
  /// журнала, и перебрасывали бы сессию наверх без причины. Заполняется в той же транзакции,
  /// что и вставка события.
  lastEventAt DateTime @default(now())

  /// Заметки агента этой сессии — состояние инструментов `read_notes` / `write_note`.
  notes Json @default("[]")

  /// Запись справочника, закреплённая за сессией. Меняется между ходами: массив сообщений
  /// собирается из журнала заново на каждый ход, поэтому смена модели посреди диалога не
  /// требует ничего дополнительного. Пусто, пока модель не назначена — чат создан при
  /// пустом справочнике и получит модель по умолчанию первым ходом, — и после удаления записи.
  modelId String?
  model   LlmModel? @relation(fields: [modelId], references: [id], onDelete: SetNull)

  /// Идентификатор модели, назначенной сессии. Хранится отдельно от связи, потому что при
  /// удалении записи связь обнуляется, а отметка остаётся. По ней ход отличает сессию, чья
  /// модель удалена, от сессии без модели: в первой ход отклоняется, пока не выбрана другая
  /// модель, а вторая получает модель по умолчанию. Подставлять модель по умолчанию вместо
  /// назначенной нельзя. Если та же модель заведена заново, связь восстанавливается по
  /// идентификатору: у записи он неизменяем.
  modelIdentifier String?

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  events    SessionEvent[]

  @@index([ownerId, lastEventAt])
  @@index([parentId])
  @@map("sessions")
}

/// Событие сессии: перечень того, что фактически произошло. Записи добавляются в конец и
/// не изменяются. Массив сообщений для модели строится из журнала, а не хранится отдельно.
model SessionEvent {
  id        Int      @id @default(autoincrement())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  seq       Int
  type      String
  payload   Json
  createdAt DateTime @default(now())

  @@unique([sessionId, seq])
  @@index([sessionId, seq])
  @@map("session_events")
}

/// Снимок постоянной части запроса к модели: указаний платформы, секций серверов MCP и
/// описаний инструментов. Событие начала шага ссылается на снимок, поэтому по журналу
/// восстанавливается весь отправленный запрос, а не только переписка.
///
/// Идентификатор — хеш содержимого, и одинаковое содержимое хранится одной записью: описания
/// инструментов занимают десятки килобайт, и повторять их в журнале на каждом шаге значило
/// бы раздувать его без пользы. С сессиями снимок не связан: на одну запись ссылаются все
/// сессии с тем же набором, поэтому удаление сессии его не затрагивает.
model RequestSnapshot {
  id        String   @id
  prompt    String
  /// Секции, дописанные к указаниям: текстовые инструкции серверов MCP.
  sections  Json
  /// Инструменты в том порядке, в каком ушли модели: имя, описание, схема аргументов, источник.
  tools     Json
  createdAt DateTime @default(now())

  @@map("request_snapshots")
}
