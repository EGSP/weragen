# ─── База данных ──────────────────────────────────────────────────────────────
POSTGRES_USER=weragen
POSTGRES_PASSWORD=weragen
POSTGRES_DB=weragen
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql://weragen:weragen@localhost:5433/weragen

# ─── Сервер ───────────────────────────────────────────────────────────────────
PORT=3100
CORS_ORIGIN=http://localhost:5273,http://127.0.0.1:5273

# ─── Провайдер модели ─────────────────────────────────────────────────────────
# Модели заводятся не здесь, а в справочнике (раздел «Модели» в интерфейсе): пока
# справочник пуст, ход агента не запускается.
# ОБЯЗАТЕЛЬНО: каталог Yandex Cloud. Короткие идентификаторы моделей справочника
# дополняются им до URI вида gpt://<каталог>/<модель>.
YANDEX_FOLDER_ID=
# YANDEX_BASE_URL=https://llm.api.cloud.yandex.net/v1

# Аутентификация в Yandex Cloud: либо готовый IAM-токен, либо ключ сервисного аккаунта,
# из которого сервер сам подписывает JWT и обменивает его на IAM-токен.
# YANDEX_IAM_TOKEN=
YANDEX_KEY_ID=
YANDEX_SERVICE_ACCOUNT_ID=
YANDEX_PRIVATE_KEY=""

# ─── Поведение агента ─────────────────────────────────────────────────────────
# AGENT_MAX_STEPS=10
# AGENT_TEMPERATURE=0.3
# AGENT_MAX_TOKENS=
# TOOL_RESULT_MAX_CHARS=8000

# ─── Воркфлоу ─────────────────────────────────────────────────────────────────
# Процесс воркфлоу запускается платформой на каждое исполнение и на время работы
# обслуживает HTTP на выданном ему порту. Адрес платформы передаётся процессу, чтобы он
# мог обращаться к её контроллерам; отдельная переменная нужна потому, что за обратным
# прокси собственный порт сервера процессу не подходит.
# PUBLIC_URL=http://127.0.0.1:3100
# WORKFLOW_PORT_RANGE_START=3200
# WORKFLOW_PORT_RANGE_SIZE=64
# WORKFLOW_MAX_PROCESSES=4
# WORKFLOW_READY_TIMEOUT_MS=20000
# Первая ступень прерывания: сколько ждать самостоятельного завершения процесса,
# прежде чем завершать его принудительно.
# WORKFLOW_CANCEL_TIMEOUT_MS=5000

# ─── Подключения MCP ──────────────────────────────────────────────────────────
# Пределов времени два, а не один. Первый покрывает подключение, инициализацию и запрос
# перечня инструментов; второй — один вызов инструмента. Общий предел оставил бы зависший
# сервер удерживать ход агента до его отмены.
# MCP_CONNECT_TIMEOUT_MS=30000
# MCP_CALL_TIMEOUT_MS=60000
# Пороги предупреждения об объёме набора инструментов. Набор не сокращается: сокращение без
# ведома администратора спрятало бы причину, по которой агент не видит инструмента.
# MCP_WARN_TOOL_COUNT=60
# MCP_WARN_SCHEMA_CHARS=60000

# ─── Трассировка ──────────────────────────────────────────────────────────────
# Пусто — телеметрия не отправляется и экспортёр не создаётся.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006
# OTEL_SERVICE_NAME=weragen-server
# OTEL_CAPTURE_CONTENT=true

# ─── Клиент ───────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3100
VITE_PORT=5273
